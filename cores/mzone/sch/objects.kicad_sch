	(text "~{OBEN} enabled when total\nVPOS = 240..495 -> to draw a sprite on line\nLine		YPOS	\n240			0\n239,240		1		\n0			240\n0,1			239\n0-15		225		"
		(exclude_from_sim no)
		(at 254 29.21 0)
		(effects
