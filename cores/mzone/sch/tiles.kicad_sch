	(text "H2S = H2F + SCRY1\nH4S = H4F + SCRY2\nH8S = H8F + SCRY3\nH16S = H16F + SCRY4\nH32S = H32F + SCRY5\nH64S = H64F + SCRY6\nH128S = H128F + SCRY7\n\nSCRY0 selects which of the two pixels are being rendered first."
		(exclude_from_sim no)
		(at 77.47 194.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
