[all]
include ../../kicker/cfg/common.def
JTFRAME_MCLK=49153840

JTFRAME_WIDTH=288
JTFRAME_HEIGHT=224

CORENAME=JTMZONE
GAMETOP=jtmzone_game_sdram

MAIN_MODULE=jtmzone_main
# VIDEO_MODULE=jtmzone_video
SND_MODULE=jtmzone_snd

MAIN_START=0x00000
SND_START =0x10000
DAC_START =0x12000
OBJ_START =0x13000
SCR_START =0x1B000
JTFRAME_PROM_START=0x1F000

# Mega Zone is a vertical game in MAME.
JTFRAME_VERTICAL
JTFRAME_FLIP_RESET
